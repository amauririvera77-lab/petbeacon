# Copia este archivo a .env y completa con Settings → API de tu proyecto Supabase.
# La anon key es pública por diseño (protegida por RLS) — nunca pongas aquí la service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox: SOLO el token público (pk.…). GL JS en WebView no usa el secreto (sk.…); no lo pongas aquí.
EXPO_PUBLIC_MAPBOX_TOKEN=
