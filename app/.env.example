# Copia este archivo a .env y completa con Settings → API de tu proyecto Supabase.
# La anon key es pública por diseño (protegida por RLS) — nunca pongas aquí la service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox: SOLO el token público (pk.…). GL JS en WebView no usa el secreto (sk.…); no lo pongas aquí.
EXPO_PUBLIC_MAPBOX_TOKEN=

# URL pública de la página web mínima (carpeta web/ del repo, desplegada en Vercel/Netlify), sin barra final.
# El QR de los flyers apunta a <URL>/r/<id-del-reporte>. Sin esto, el flyer se genera sin QR.
EXPO_PUBLIC_WEB_BASE_URL=

# ⚠️ HERRAMIENTA DE DISEÑO — quitar o poner en false antes de publicar (ver nota en CLAUDE.md).
# En true, muestra "Design tools → Replay onboarding" al final de Profile (revisar el onboarding sin cerrar sesión
# ni escribir datos reales). Se lee con process.env, no con __DEV__, para poder activarla también en builds de EAS Update.
EXPO_PUBLIC_SHOW_DESIGN_TOOLS=false

# Datos de muestra en Support: el banner "These resources are sample data for testing." se MUESTRA por defecto. Pon true SOLO
# para tomar capturas del case study — nunca en un build real mientras los recursos sigan siendo de muestra (ver CLAUDE.md).
EXPO_PUBLIC_HIDE_SAMPLE_NOTICE=false
