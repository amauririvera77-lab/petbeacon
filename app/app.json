{
  "expo": {
    "name": "PetBeacon",
    "slug": "petbeacon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.petbeacon.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.petbeacon.mobile",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PetBeacon uses your location to show lost and sighted pets near you and to pin your reports."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PetBeacon needs your photos so you can attach a picture of the pet to a report.",
          "cameraPermission": "PetBeacon uses the camera so you can take a picture of the pet for a report."
        }
      ],
      "expo-sharing"
    ],
    "scheme": "petbeacon",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "04276a7c-6447-48cb-a17b-facf9821ef8a"
      }
    },
    "owner": "amauririvera"
  }
}
